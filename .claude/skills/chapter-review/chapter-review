#!/usr/bin/env node
// chapter-review: the agent-facing command for talking to the chapter-review
// VSCode extension. It owns the two-file protocol inside the git dir
// (chapters.json, focus.json) so the skill interacts through intent-level
// commands instead of reading and writing those paths by hand.
//
//   chapter-review focus                    print what the reviewer is looking at
//   chapter-review show                     print the current manifest
//   chapter-review base-check [base]        check the review base is fresh (read-only)
//   chapter-review write [file]             validate a partition draft, then install it
//   chapter-review uncheck      <flags>     clear a review checkmark (re-read)
//   chapter-review issue add    <flags>     record a review finding
//   chapter-review issue set    <id> <flags>  revise a finding
//   chapter-review issue resolve <id>       mark a finding resolved
//   chapter-review issue reopen  <id>       reopen a finding
//   chapter-review issue verify  <id>       mark a finding's premise verified
//   chapter-review issue unverify <id>      mark a finding suspected (unchecked)
//   chapter-review issue rm      <id>       drop a finding
//   chapter-review issue list               list findings
//
// This file stays deliberately empty of logic. It has no extension so it can be
// run as `chapter-review`, and Node only strips types from .ts/.mts/.cts — so
// anything written here would be plain JavaScript that neither tsconfig nor
// ESLint checks. Dispatch therefore lives in main.ts, which both tools see.
//
// Node strips the TypeScript types of the modules it pulls in at load time
// (Node >= 22.18), so there is no build step. Zero dependencies beyond Node and
// git, so the skill directory stays portable: copy it into any repo, no npm
// install. Runnable directly (executable, node shebang) or via
// `node chapter-review <cmd>`.

// The Node floor is checked here, and the import below is dynamic, because a
// static import is resolved before any statement in this file runs: on an older
// Node the process would die with `ERR_UNKNOWN_FILE_EXTENSION ".ts"` pointing at
// main.ts, which reads as "this tool needs a build step" — the opposite of true.
// This file is the only one an old Node can parse, so it is the only place the
// check can go.
const [major = 0, minor = 0] = process.versions.node.split(".").map(Number);
if (major < 22 || (major === 22 && minor < 18)) {
  console.error(
    `chapter-review: needs Node 22.18 or newer (found ${process.versions.node}).\n` +
      "  It runs TypeScript directly using Node's type stripping; there is nothing to build or install."
  );
  process.exit(2);
}

const { main } = await import("./main.ts");

main(process.argv.slice(2));
