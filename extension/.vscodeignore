# Ship only the compiled extension and its docs. Sources, build config and
# dev tooling stay out of the .vsix.
.vscode/**
.vscode-test/**
.vscode-test.mjs
src/**
out/test/**
**/*.ts
**/*.map
tsconfig.json
tsconfig.package.json
scripts/**

# Nothing references this one: package.json points at media/icon.png, and the
# viewsContainer at media/chapter-review.svg.
media/icon.svg
.gitignore
.vscodeignore
.npmrc
node_modules/**

# ...except the bundled skill, whose TypeScript *is* its runtime form: Node
# strips the types at load, so skill/*.ts are shipped files, not sources. The
# `**/*.ts` rule above would otherwise strip every module out of the skill and
# leave the shim importing a main.ts that isn't there — an install that reports
# success and then fails with ERR_MODULE_NOT_FOUND on first use. Keep this last;
# in .vscodeignore the final matching pattern wins.
!skill/**
